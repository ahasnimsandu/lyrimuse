<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06070B">

    <me.lyrimuse.android.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <me.lyrimuse.android.RoundedImageView
                android:id="@+id/coverMini"
                android:layout_width="46dp"
                android:layout_height="46dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textSize="9sp"
                    android:letterSpacing="0.18"
                    android:textStyle="bold"
                    android:textColor="#B9F5D6" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:text="Nothing playing" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="#A8AEBD"
                    android:text="Start a song in any player" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:background="@drawable/circle_glass"
                android:src="@drawable/ic_settings"
                android:tint="#EDEFF6"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- permission card -->
        <LinearLayout
            android:id="@+id/permBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/permTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="#D5D9E2"
                android:text="Grant notification access to read the current song." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/pill_accent"
                    android:textColor="#B9F5D6"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:text="Grant access" />

                <Button
                    android:id="@+id/btnOverlayPerm"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_soft"
                    android:textColor="#EDEFF6"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:text="Allow overlay" />
            </LinearLayout>
        </LinearLayout>

        <!-- big artwork -->
        <me.lyrimuse.android.RoundedImageView
            android:id="@+id/coverLarge"
            android:layout_width="186dp"
            android:layout_height="186dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="10sp"
            android:textColor="#8FE8C0" />

        <me.lyrimuse.android.KaraokeView
            android:id="@+id/karaoke"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp" />

        <!-- glass controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/elapsed"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#9AA1B0"
                    android:text="0:00" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="#7BE8B3"
                    android:progressBackgroundTint="#33FFFFFF" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="10sp"
                    android:textColor="#9AA1B0"
                    android:text="0:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/circle_glass"
                    android:src="@drawable/ic_prev"
                    android:tint="#EDEFF6"
                    android:contentDescription="Previous" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:padding="17dp"
                    android:background="@drawable/pill_play"
                    android:src="@drawable/ic_play"
                    android:tint="#08130E"
                    android:contentDescription="Play or pause" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/circle_glass"
                    android:src="@drawable/ic_next"
                    android:tint="#EDEFF6"
                    android:contentDescription="Next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnFind"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/pill_soft"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="6dp"
                    android:drawableTint="#C9CFDC"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Re-match"
                    android:textColor="#E9ECF3"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFloat"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:gravity="center"
                    android:background="@drawable/pill_soft"
                    android:drawableStart="@drawable/ic_float"
                    android:drawablePadding="6dp"
                    android:drawableTint="#C9CFDC"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Floating"
                    android:textColor="#E9ECF3"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/pill_soft"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="6dp"
                    android:drawableTint="#C9CFDC"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Find lyrics"
                    android:textColor="#E9ECF3"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
