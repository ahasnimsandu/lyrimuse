<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/permBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/permTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#C7CBD4"
                android:text="Grant notification access to read the current song." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/pill_accent"
                    android:textColor="#B9F5D6"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:text="Grant access" />

                <Button
                    android:id="@+id/btnOverlayPerm"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill"
                    android:textColor="#E7EAF0"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:text="Allow overlay" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/art"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/card"
                android:scaleType="centerCrop"
                android:contentDescription="Album art"
                android:src="@drawable/ic_note" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#F2F3F7"
                    android:text="Nothing playing" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="13sp"
                    android:textColor="#9AA0AE" />

                <TextView
                    android:id="@+id/source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="#66D9A0" />
            </LinearLayout>

            <TextView
                android:id="@+id/player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="90dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="#6E7482" />
        </LinearLayout>

        <me.lyrimuse.android.KaraokeView
            android:id="@+id/karaoke"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/elapsed"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#7A8090"
                android:text="0:00" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="#66D9A0"
                android:progressBackgroundTint="#23262E" />

            <TextView
                android:id="@+id/total"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="10sp"
                android:textColor="#7A8090"
                android:text="0:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⏮"
                android:textSize="20sp"
                android:textColor="#E7EAF0"
                android:background="@drawable/pill"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="76dp"
                android:layout_height="52dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:gravity="center"
                android:text="▶"
                android:textSize="20sp"
                android:textColor="#0B0D12"
                android:background="@drawable/pill_play"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⏭"
                android:textSize="20sp"
                android:textColor="#E7EAF0"
                android:background="@drawable/pill"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/btnFind"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Find lyrics"
                android:textSize="12sp"
                android:textColor="#E7EAF0"
                android:background="@drawable/pill"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFloat"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:gravity="center"
                android:text="Floating"
                android:textSize="12sp"
                android:textColor="#E7EAF0"
                android:background="@drawable/pill"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Settings"
                android:textSize="12sp"
                android:textColor="#E7EAF0"
                android:background="@drawable/pill"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
